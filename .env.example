# WebDashy — environment variables
#
# Copy this file to `.env` and fill in real values.
# NEVER commit the real `.env` file — it is gitignored.

# --- Postgres (used by docker-compose.yml's `db` service) ---
POSTGRES_USER=webdashy
POSTGRES_PASSWORD=change-me-to-a-strong-random-password
POSTGRES_DB=webdashy

# --- App database connection (used by Prisma, once the app exists) ---
# Inside Docker Compose, the host is the service name `db`, not localhost.
DATABASE_URL=postgresql://webdashy:change-me-to-a-strong-random-password@db:5432/webdashy

# --- Admin authentication (Auth.js, Credentials provider) ---
# Signs/encrypts session JWTs. Required. Generate a real one — do not use a
# placeholder in production. `openssl rand -base64 32` works well.
AUTH_SECRET=generate-with-openssl-rand-base64-32

# Your admin account itself is created through the app at /setup (a
# one-time page, only reachable while the database has zero users) — not
# through these variables. Leave the three below commented out/unset
# unless you're specifically locked out and need an emergency reset:
# running `npm run db:seed` with these set will upsert (create-or-reset)
# that account by email, bypassing the UI entirely.
# ADMIN_NAME=Garrett Morgan
# ADMIN_EMAIL=garrett.morgan.pro@gmail.com
# ADMIN_PASSWORD=change-me-to-a-strong-password

# --- Email notifications (client selects a template) ---
# Sent via Gmail SMTP using an App Password — NOT your regular Gmail
# password. Generate one at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification enabled on the Google account).
# If these are left unset, notifications are silently skipped — the
# selection itself still works either way.
GMAIL_USER=your-gmail-address@gmail.com
GMAIL_APP_PASSWORD=your-16-character-app-password
# Optional — defaults to GMAIL_USER if unset. Who receives the notification.
NOTIFY_EMAIL_TO=garrett.morgan.pro@gmail.com
# Optional — defaults to GMAIL_USER if unset. Overrides the visible "From"
# address (e.g. garrett@webdashy.com) while GMAIL_USER stays the actual
# SMTP login. Only works once that address is verified as a Gmail "Send
# mail as" alias (Settings → Accounts → Send mail as, in Gmail itself) —
# Gmail silently rejects/rewrites an unverified From no matter what's set
# here.
MAIL_FROM=garrett@webdashy.com

# --- App runtime ---
NODE_ENV=production
