# WebDashy — environment variables
#
# Copy this file to `.env` and fill in real values.
# NEVER commit the real `.env` file — it is gitignored.

# --- Postgres (used by docker-compose.yml's `db` service) ---
POSTGRES_USER=webdashy
POSTGRES_PASSWORD=change-me-to-a-strong-random-password
POSTGRES_DB=webdashy

# --- App database connection (used by Prisma, once the app exists) ---
# Inside Docker Compose, the host is the service name `db`, not localhost.
DATABASE_URL=postgresql://webdashy:change-me-to-a-strong-random-password@db:5432/webdashy

# --- Admin authentication (exact variables depend on chosen provider) ---
# Example for Auth.js:
# AUTH_SECRET=generate-with-openssl-rand-base64-32
# AUTH_URL=http://<vm-ip>

# --- Email notifications (client selects a template) ---
# Sent via Gmail SMTP using an App Password — NOT your regular Gmail
# password. Generate one at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification enabled on the Google account).
# If these are left unset, notifications are silently skipped — the
# selection itself still works either way.
GMAIL_USER=your-gmail-address@gmail.com
GMAIL_APP_PASSWORD=your-16-character-app-password
# Optional — defaults to GMAIL_USER if unset. Who receives the notification.
NOTIFY_EMAIL_TO=garrett.morgan.pro@gmail.com

# --- App runtime ---
NODE_ENV=production
