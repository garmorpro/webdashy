// WebDashy — Prisma schema
// Mirrors the data model documented in ARCHITECTURE.md §4.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Admin ---

model User {
  id                  String    @id @default(cuid())
  name                String
  email               String    @unique
  passwordHash        String
  // "Forgot password" flow — a SHA-256 hash of the raw token emailed to the
  // user, not the token itself (so a DB leak alone can't be used to reset
  // the password; the raw token only ever exists in the email). Nullable:
  // unset once used or after successful login isn't required, but is
  // cleared immediately on a successful reset either way. See
  // src/lib/actions/password-reset.ts.
  resetTokenHash      String?   @unique
  resetTokenExpiresAt DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  confirmedBuildSetups BuildSetup[]
}

// --- Template Library ---

enum TemplateStatus {
  ACTIVE
  DRAFT
  ARCHIVED
}

model Template {
  id                   String         @id @default(cuid())
  name                 String
  slug                 String         @unique
  description          String?
  categoryId           String?
  category             Category?      @relation(fields: [categoryId], references: [id])
  thumbnailUrl         String?
  desktopScreenshotUrl String?
  mobileScreenshotUrl  String?
  previewUrl           String?
  repositoryUrl        String?
  isFavorite           Boolean        @default(false)
  status               TemplateStatus @default(DRAFT)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  tags            TemplateTag[]
  portalTemplates PortalTemplate[]
  portalEvents    PortalEvent[]
  selections      TemplateSelection[]
  buildSetups     BuildSetup[]

  @@index([categoryId])
  @@index([status])
}

model Category {
  id   String @id @default(cuid())
  name String
  slug String @unique

  templates Template[]
}

model Tag {
  id   String @id @default(cuid())
  name String @unique

  templates TemplateTag[]
}

model TemplateTag {
  templateId String
  tagId      String

  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  tag      Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([templateId, tagId])
}

// --- Clients CRM ---

// Mirrors the 8-step pipeline (Add Lead → Contact → Portal Sent →
// Template & Plan → Invoice → Building → Delivered → Complete) added on
// top of the original MVP flow — see ARCHITECTURE.md §4 "Client pipeline".
enum ClientStatus {
  LEAD
  CONTACTED
  INTERESTED
  QUESTIONNAIRE_SENT
  QUESTIONNAIRE_DONE
  PORTAL_SENT
  VIEWED
  TEMPLATE_SELECTED
  INVOICE_SENT
  BUILDING
  DELIVERED
  WON
  LOST
}

// Canonical lifecycle progress for Client Workflow V2. ClientStatus remains
// in place during the migration period for existing UI and automation.
enum WorkflowStage {
  ADD_LEAD
  CONTACT
  QUESTIONNAIRE_SENT
  QUESTIONNAIRE_COMPLETE
  PORTAL_SENT
  TEMPLATE_AND_PLAN
  BUILD_SETUP
  WEBSITE_DRAFT
  CLIENT_REVIEW
  REVISIONS_APPROVED
  INVOICE
  PAYMENT_RECEIVED
  LAUNCH_AND_HANDOFF
  CLIENT_CARE
}

model Client {
  id             String        @id @default(cuid())
  businessName   String
  contactName    String
  email          String
  phone          String?
  website        String?
  industry       String?
  status         ClientStatus  @default(LEAD)
  workflowStage  WorkflowStage @default(ADD_LEAD)
  leadSource     String?
  estimatedValue Decimal?      @db.Decimal(10, 2)
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  portals       Portal[]
  invoices      Invoice[]
  questionnaire DesignQuestionnaire?

  @@index([status])
  @@index([workflowStage])
}

// --- Design Questionnaire (sent after a lead confirms they want a site,
// before a template portal exists — see DesignQuestionnaire below) ---

enum QuestionnaireStatus {
  SENT
  IN_PROGRESS
  SUBMITTED
}

// One per client (a client is only ever sent one questionnaire — resending
// reuses the same row/token rather than creating a second one). `answers`
// is a single JSON blob keyed by field id (see src/lib/questionnaire-schema.ts
// for the ~35-field schema and TS types) rather than one column per
// question — unlike ProjectRequirements/Invoice, nothing here needs to be
// individually queried or filtered, it's just a long free-text intake form,
// and a JSON blob means adding/renaming a question later never needs a
// migration.
model DesignQuestionnaire {
  id          String              @id @default(cuid())
  clientId    String              @unique
  client      Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  token       String              @unique
  status      QuestionnaireStatus @default(SENT)
  answers     Json?
  sentAt      DateTime            @default(now())
  submittedAt DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  buildSetups BuildSetup[]
}

// --- Portals ---

enum PortalStatus {
  DRAFT
  ACTIVE
  VIEWED
  SELECTED
  DISABLED
}

model Portal {
  id            String       @id @default(cuid())
  clientId      String
  client        Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  token         String       @unique
  message       String?
  status        PortalStatus @default(DRAFT)
  firstViewedAt DateTime?
  lastViewedAt  DateTime?
  viewCount     Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  templates    PortalTemplate[]
  events       PortalEvent[]
  selection    TemplateSelection?
  requirements ProjectRequirements?
  buildSetup   BuildSetup?
  delivery     Delivery?
  invoices     Invoice[]

  @@index([clientId])
  @@index([token])
}

model PortalTemplate {
  id           String @id @default(cuid())
  portalId     String
  templateId   String
  displayOrder Int    @default(0)

  portal   Portal   @relation(fields: [portalId], references: [id], onDelete: Cascade)
  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([portalId, templateId])
  @@index([portalId])
  @@index([templateId])
}

enum PortalEventType {
  PORTAL_VIEWED
  TEMPLATE_PREVIEWED
  TEMPLATE_SELECTED
}

model PortalEvent {
  id         String          @id @default(cuid())
  portalId   String
  templateId String?
  eventType  PortalEventType
  createdAt  DateTime        @default(now())

  portal   Portal    @relation(fields: [portalId], references: [id], onDelete: Cascade)
  template Template? @relation(fields: [templateId], references: [id])

  @@index([portalId])
  @@index([templateId])
}

model TemplateSelection {
  id         String   @id @default(cuid())
  portalId   String   @unique
  templateId String
  // Nullable: selections made before Plan selection was added to the
  // portal flow won't have one. New selections always set it — see
  // confirmPortalSelection in src/lib/actions/public-portal.ts.
  planId     String?
  selectedAt DateTime @default(now())

  portal      Portal       @relation(fields: [portalId], references: [id], onDelete: Cascade)
  template    Template     @relation(fields: [templateId], references: [id])
  plan        Plan?        @relation(fields: [planId], references: [id])
  buildSetups BuildSetup[]

  @@index([templateId])
  @@index([planId])
}

// --- Plans & Pricing (Settings → Plans & Pricing) ---

// Defaults to ONE_TIME so existing rows (created before this field existed)
// keep displaying exactly as they always did — the portal plan card
// hardcoded a "one-time" label for every plan until this was added.
enum PlanBillingType {
  ONE_TIME
  MONTHLY
}

// Client-portal product lines shown as tabs (e.g. "Websites" / "Reviews" /
// "Website + Reviews") — open-ended and admin-managed, same idea as
// Template's Category model, kept as its own model rather than reusing that
// one since the two are unrelated concepts (a product line vs. a template
// style). displayOrder controls left-to-right tab order.
model PlanCategory {
  id           String   @id @default(cuid())
  name         String
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  plans Plan[]
}

model Plan {
  id            String          @id @default(cuid())
  name          String
  price         Decimal         @db.Decimal(10, 2)
  billingType   PlanBillingType @default(ONE_TIME)
  // Nullable so existing plans aren't broken by this migration — the portal
  // shows an uncategorized plan under a synthesized "Other" tab until the
  // admin assigns a real category. A one-time plan's category is what
  // determines which tab's "pay once?" footer/modal it shows up in.
  categoryId    String?
  category      PlanCategory?   @relation(fields: [categoryId], references: [id])
  // Two independent highlight badges shown on the client portal (and
  // mirrored on the admin's own plan cards) — isPopular is the bold
  // top-ribbon "Most Popular" treatment, isRecommended a smaller
  // top-corner "Recommended" tag. Neither is mutually exclusive with the
  // other, and neither is DB-enforced to a single plan — admins can flag
  // more than one, the UI just shows the badge on whichever are flagged.
  isPopular     Boolean         @default(false)
  isRecommended Boolean         @default(false)
  tagline       String?
  features      String[]
  isActive      Boolean         @default(true)
  displayOrder  Int             @default(0)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  selections  TemplateSelection[]
  buildSetups BuildSetup[]

  // "Why bundle?" panel on the client portal — deliberately hand-typed, not
  // computed from other plans (an earlier version linked real component
  // plans and computed the savings automatically; the admin found picking
  // components more friction than it was worth and asked for a plain
  // toggle + free text instead, accepting the tradeoff that this copy can
  // drift from the plans' real prices over time if not kept up to date).
  isBundle          Boolean  @default(false)
  // Short paragraph explaining the bundle's value ("Buying them separately
  // adds up fast...").
  bundleWhyText     String?
  // One comparison line per entry, e.g. "Website only — $175/mo" — shown
  // as a simple list above the savings line.
  bundleLines       String[]
  // The highlighted savings callout, e.g. "You save $57/month" — typed
  // verbatim, not calculated.
  bundleSavingsText String?
  // Optional closing line under the panel, e.g. "Just want a website?
  // Head to the Websites tab — no reviews, no problem."
  bundleFooterText  String?

  @@index([isActive])
  @@index([categoryId])
}

// Single-row app-wide settings (id is always the literal "singleton" — see
// prisma/seed.mjs, which upserts it). Simpler than a dedicated
// key/value table for the handful of app-level toggles we have so far.
model AppSettings {
  id                         String    @id @default("singleton")
  showPricingInPortal        Boolean   @default(true)
  invoiceFromName            String?
  invoiceFromAddress         String?
  invoicePaymentInstructions String?
  invoiceTerms               String    @default("Net 14")
  // Shown as the clickable trigger text for the "pay once instead?" popup
  // on the client portal (only rendered at all when at least one ONE_TIME
  // Plan exists) — a single line covering every one-time plan, rather than
  // per-plan text, since the popup already lists each option's own name/
  // price/features individually. Null falls back to a generic default.
  oneTimeFooterNote          String?
  // For the POST /api/leads webhook (e.g. an Apple Shortcut) — same hashed-
  // secret pattern as User.resetTokenHash above, never store the raw key.
  // apiKeyPreview is just the key's last 4 chars, purely so the Settings UI
  // can show "...a1b2" to help tell a rotated key apart from an old one.
  apiKeyHash                 String?
  apiKeyPreview              String?
  apiKeyCreatedAt            DateTime?
  updatedAt                  DateTime  @updatedAt
}

// --- Project Requirements (client detail page, filled in after selection) ---

enum ContentStatus {
  CLIENT_PROVIDED
  NEEDS_COPYWRITING
  MIXED
}

model ProjectRequirements {
  id               String        @id @default(cuid())
  portalId         String        @unique
  pages            String[]
  features         String[]
  contentStatus    ContentStatus @default(CLIENT_PROVIDED)
  targetLaunchDate DateTime?
  notes            String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  portal      Portal       @relation(fields: [portalId], references: [id], onDelete: Cascade)
  buildSetups BuildSetup[]
}

enum BuildSetupStatus {
  DRAFT
  CONFIRMED
}

enum RepositoryVisibility {
  PRIVATE
  PUBLIC
}

enum WebsiteProvisioningStatus {
  NOT_STARTED
  IN_PROGRESS
  SUCCEEDED
  FAILED
  NEEDS_RECONCILIATION
}

enum NetlifyProvisioningStatus {
  NOT_STARTED
  IN_PROGRESS
  DEPLOYING
  SUCCEEDED
  FAILED
  NEEDS_RECONCILIATION
}

model BuildSetup {
  id                    String               @id @default(cuid())
  portalId              String               @unique
  templateSelectionId   String
  projectRequirementsId String?
  questionnaireId       String?
  status                BuildSetupStatus     @default(DRAFT)
  generatedAt           DateTime             @default(now())
  confirmedAt           DateTime?
  confirmedByUserId     String?
  projectName           String
  siteSlug              String
  repositoryName        String
  repositoryOwner       String?
  repositoryVisibility  RepositoryVisibility @default(PRIVATE)
  sourceRepositoryUrl   String
  sourceRef             String?
  primaryDomain         String?
  existingWebsiteUrl    String?
  templateId            String
  templateNameSnapshot  String
  templateSlugSnapshot  String
  planId                String?
  planNameSnapshot      String?
  planFeaturesSnapshot  String[]
  businessProfile       Json
  pages                 Json
  features              Json
  contentStatus         ContentStatus
  contentBrief          Json
  designBrief           Json
  targetLaunchDate      DateTime?
  notes                 String?
  unresolvedItems       String[]
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  portal              Portal               @relation(fields: [portalId], references: [id], onDelete: Cascade)
  templateSelection   TemplateSelection    @relation(fields: [templateSelectionId], references: [id])
  template            Template             @relation(fields: [templateId], references: [id])
  plan                Plan?                @relation(fields: [planId], references: [id], onDelete: SetNull)
  projectRequirements ProjectRequirements? @relation(fields: [projectRequirementsId], references: [id], onDelete: SetNull)
  questionnaire       DesignQuestionnaire? @relation(fields: [questionnaireId], references: [id], onDelete: SetNull)
  confirmedByUser     User?                @relation(fields: [confirmedByUserId], references: [id], onDelete: SetNull)
  websiteProvisioning WebsiteProvisioning?

  @@index([templateSelectionId])
  @@index([projectRequirementsId])
  @@index([questionnaireId])
  @@index([confirmedByUserId])
  @@index([status])
}

model WebsiteProvisioning {
  id                   String                    @id @default(cuid())
  buildSetupId         String                    @unique
  status               WebsiteProvisioningStatus @default(NOT_STARTED)
  sourceOwner          String
  sourceRepositoryName String
  sourceRepositoryUrl  String
  targetOwner          String
  targetRepositoryName String
  requestedVisibility  RepositoryVisibility
  githubRepositoryId   BigInt?
  githubNodeId         String?
  repositoryUrl        String?
  actualVisibility     RepositoryVisibility?
  defaultBranch        String?
  attemptCount         Int                       @default(0)
  lastAttemptAt        DateTime?
  provisionedAt        DateTime?
  failedAt             DateTime?
  lastErrorCode        String?
  lastErrorMessage     String?
  githubRequestId      String?
  startedAt            DateTime?
  leaseExpiresAt       DateTime?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt

  buildSetup          BuildSetup           @relation(fields: [buildSetupId], references: [id], onDelete: Cascade)
  netlifyProvisioning NetlifyProvisioning?

  @@index([status])
  @@index([status, leaseExpiresAt])
  @@index([targetOwner, targetRepositoryName])
}

model NetlifyProvisioning {
  id                          String                    @id @default(cuid())
  websiteProvisioningId       String                    @unique
  status                      NetlifyProvisioningStatus @default(NOT_STARTED)
  netlifySiteId               String?                   @unique
  siteName                    String
  adminUrl                    String?
  siteUrl                     String?
  sslUrl                      String?
  accountSlug                 String
  githubRepositoryId          BigInt
  repositoryPath              String
  repositoryBranch            String
  netlifyGithubInstallationId BigInt
  initialBuildId              String?
  initialDeployId             String?
  initialDeployState          String?
  initialDeployUrl            String?
  initialDeploySslUrl         String?
  attemptCount                Int                       @default(0)
  lastAttemptAt               DateTime?
  startedAt                   DateTime?
  siteCreatedAt               DateTime?
  provisionedAt               DateTime?
  failedAt                    DateTime?
  leaseExpiresAt              DateTime?
  lastErrorCode               String?
  lastErrorMessage            String?
  createdAt                   DateTime                  @default(now())
  updatedAt                   DateTime                  @updatedAt

  websiteProvisioning WebsiteProvisioning @relation(fields: [websiteProvisioningId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([status, leaseExpiresAt])
  @@index([siteName])
}

// --- Invoicing ---
// Track-only for now — no real payment processor. status is set to PAID by
// the admin manually marking it so. stripeInvoiceId/stripePaymentUrl are
// reserved, unused columns for a future real Stripe integration, so that
// swap-in doesn't need another migration — see ARCHITECTURE.md §9.

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
}

model Invoice {
  id               String        @id @default(cuid())
  invoiceNumber    String        @unique
  clientId         String
  portalId         String?
  status           InvoiceStatus @default(DRAFT)
  issueDate        DateTime      @default(now())
  dueDate          DateTime?
  taxAmount        Decimal       @default(0) @db.Decimal(10, 2)
  notes            String?
  sentAt           DateTime?
  paidAt           DateTime?
  stripeInvoiceId  String?
  stripePaymentUrl String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  client    Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  portal    Portal?           @relation(fields: [portalId], references: [id])
  lineItems InvoiceLineItem[]

  @@index([clientId])
  @@index([portalId])
}

model InvoiceLineItem {
  id           String  @id @default(cuid())
  invoiceId    String
  description  String
  amount       Decimal @db.Decimal(10, 2)
  displayOrder Int     @default(0)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

// --- Build & Delivery ---

enum DeliveryStatus {
  BUILDING
  DELIVERED
}

enum ReviewStatus {
  AWAITING
  APPROVED
  CHANGES_REQUESTED
}

model Delivery {
  id             String         @id @default(cuid())
  portalId       String         @unique
  status         DeliveryStatus @default(BUILDING)
  stagingUrl     String?
  liveUrl        String?
  reviewToken    String?        @unique
  reviewStatus   ReviewStatus   @default(AWAITING)
  reviewFeedback String?
  deliveredAt    DateTime?
  reviewedAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  portal  Portal           @relation(fields: [portalId], references: [id], onDelete: Cascade)
  reviews DeliveryReview[]

  @@index([reviewToken])
}

model DeliveryReview {
  id          String       @id @default(cuid())
  deliveryId  String
  cycle       Int
  stagingUrl  String
  status      ReviewStatus @default(AWAITING)
  feedback    String?
  sentAt      DateTime     @default(now())
  respondedAt DateTime?

  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@unique([deliveryId, cycle])
  @@index([deliveryId, sentAt])
}
