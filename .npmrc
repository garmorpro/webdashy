# next-auth declares nodemailer (^7||^8) as an *optional* peer dependency,
# used only by its Email/magic-link provider — which this app doesn't use
# (admin auth is Credentials-only). Our own mail.ts feature needs a newer
# nodemailer (^9) for unrelated reasons, which conflicts with that unused
# peer's declared range. legacy-peer-deps avoids npm hard-failing on an
# optional, unused peer mismatch — see ARCHITECTURE.md §9.
legacy-peer-deps=true
